# ===== 飞书登录（飞书开放平台 → 创建「网页应用」）=====
# 应用凭证，在 https://open.feishu.cn/app 创建应用后获取
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# 必须与飞书后台「安全设置 → 重定向 URL」完全一致（含 https）
FEISHU_REDIRECT_URI=https://your-domain.vercel.app/api/auth

# ===== 会话签名（生成一段足够长的随机串）=====
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# ===== 免费数据库 Turso（libSQL / SQLite 兼容，免费 9GB）=====
# 在 https://turso.tech 用 GitHub 登录，创建一个数据库后得到：
TURSO_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=eyJhbGciOiJFZERTQSJ9...
